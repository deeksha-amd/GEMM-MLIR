      %bt0 = vector.bitcast %bit0 : vector<16xi32> to vector<32xbf16>
      %bit1 = vector.load %Bp[%jb, %kt, %c16] : memref<128x2048x32xi32>, vector<16xi32>
      %bt1 = vector.bitcast %bit1 : vector<16xi32> to vector<32xbf16>

      %dt0 = memref.load %Ap[%it0, %kt] : memref<128x2048xi32>
      %wt0 = vector.broadcast %dt0 : i32 to vector<16xi32>
      %at0 = vector.bitcast %wt0 : vector<16xi32> to vector<32xbf16>
      %nt0_0 = llvm.call_intrinsic "llvm.x86.avx512bf16.dpbf16ps.512"(%st0_0, %at0, %bt0)
          : (vector<16xf32>, vector<32xbf16>, vector<32xbf16>) -> vector<16xf32>
      %nt0_1 = llvm.call_intrinsic "llvm.x86.avx512bf16.dpbf16ps.512"(%st0_1, %at0, %bt1)
          : (vector<16xf32>, vector<32xbf16>, vector<32xbf16>) -> vector<16xf32>
      %dt1 = memref.load %Ap[%it1, %kt] : memref<128x2048xi32>
      %wt1 = vector.broadcast %dt1 : i32 to vector<16xi32>
      %at1 = vector.bitcast %wt1 : vector<16xi32> to vector<32xbf16>
      %nt1_0 = llvm.call_intrinsic "llvm.x86.avx512bf16.dpbf16ps.512"(%st1_0, %at1, %bt0)
          : (vector<16xf32>, vector<32xbf16>, vector<32xbf16>) -> vector<16xf32>
      %nt1_1 = llvm.call_intrinsic "llvm.x86.avx512bf16.dpbf16ps.512"(%st1_1, %at1, %bt1)
          : (vector<16xf32>, vector<32xbf16>, vector<32xbf16>) -> vector<16xf32>
      %dt2 = memref.load %Ap[%it2, %kt] : memref<128x2048xi32>
      %wt2 = vector.broadcast %dt2 : i32 to vector<16xi32>
      %at2 = vector.bitcast %wt2 : vector<16xi32> to vector<32xbf16>
      %nt2_0 = llvm.call_intrinsic "llvm.x86.avx512bf16.dpbf16ps.512"(%st2_0, %at2, %bt0)
          : (vector<16xf32>, vector<32xbf16>, vector<32xbf16>) -> vector<16xf32>
      %nt2_1 = llvm.call_intrinsic "llvm.x86.avx512bf16.dpbf16ps.512"(%st2_1, %at2, %bt1)
          : (vector<16xf32>, vector<32xbf16>, vector<32xbf16>) -> vector<16xf32>
      %dt3 = memref.load %Ap[%it3, %kt] : memref<128x2048xi32>
      %wt3 = vector.broadcast %dt3 : i32 to vector<16xi32>
      %at3 = vector.bitcast %wt3 : vector<16xi32> to vector<32xbf16>
      %nt3_0 = llvm.call_intrinsic "llvm.x86.avx512bf16.dpbf16ps.512"(%st3_0, %at3, %bt0)
          : (vector<16xf32>, vector<32xbf16>, vector<32xbf16>) -> vector<16xf32>
      %nt3_1 = llvm.call_intrinsic "llvm.x86.avx512bf16.dpbf16ps.512"(%st3_1, %at3, %bt1)
          : (vector<16xf32>, vector<32xbf16>, vector<32xbf16>) -> vector<16xf32>
      %dt4 = memref.load %Ap[%it4, %kt] : memref<128x2048xi32>
      %wt4 = vector.broadcast %dt4 : i32 to vector<16xi32>
      %at4 = vector.bitcast %wt4 : vector<16xi32> to vector<32xbf16>
      %nt4_0 = llvm.call_intrinsic "llvm.x86.avx512bf16.dpbf16ps.512"(%st4_0, %at4, %bt0)
          : (vector<16xf32>, vector<32xbf16>, vector<32xbf16>) -> vector<16xf32>
      %nt4_1 = llvm.call_intrinsic "llvm.x86.avx512bf16.dpbf16ps.512"(%st4_1, %at4, %bt1)
          : (vector<16xf32>, vector<32xbf16>, vector<32xbf16>) -> vector<16xf32>
      %dt5 = memref.load %Ap[%it5, %kt] : memref<128x2048xi32>
      %wt5 = vector.broadcast %dt5 : i32 to vector<16xi32>
      %at5 = vector.bitcast %wt5 : vector<16xi32> to vector<32xbf16>
      %nt5_0 = llvm.call_intrinsic "llvm.x86.avx512bf16.dpbf16ps.512"(%st5_0, %at5, %bt0)
          : (vector<16xf32>, vector<32xbf16>, vector<32xbf16>) -> vector<16xf32>
      %nt5_1 = llvm.call_intrinsic "llvm.x86.avx512bf16.dpbf16ps.512"(%st5_1, %at5, %bt1)
          : (vector<16xf32>, vector<32xbf16>, vector<32xbf16>) -> vector<16xf32>
      %dt6 = memref.load %Ap[%it6, %kt] : memref<128x2048xi32>
      %wt6 = vector.broadcast %dt6 : i32 to vector<16xi32>
      %at6 = vector.bitcast %wt6 : vector<16xi32> to vector<32xbf16>
      %nt6_0 = llvm.call_intrinsic "llvm.x86.avx512bf16.dpbf16ps.512"(%st6_0, %at6, %bt0)
          : (vector<16xf32>, vector<32xbf16>, vector<32xbf16>) -> vector<16xf32>
      %nt6_1 = llvm.call_intrinsic "llvm.x86.avx512bf16.dpbf16ps.512"(%st6_1, %at6, %bt1)
          : (vector<16xf32>, vector<32xbf16>, vector<32xbf16>) -> vector<16xf32>
      %dt7 = memref.load %Ap[%it7, %kt] : memref<128x2048xi32>
      %wt7 = vector.broadcast %dt7 : i32 to vector<16xi32>
      %at7 = vector.bitcast %wt7 : vector<16xi32> to vector<32xbf16>
      %nt7_0 = llvm.call_intrinsic "llvm.x86.avx512bf16.dpbf16ps.512"(%st7_0, %at7, %bt0)
          : (vector<16xf32>, vector<32xbf16>, vector<32xbf16>) -> vector<16xf32>
      %nt7_1 = llvm.call_intrinsic "llvm.x86.avx512bf16.dpbf16ps.512"(%st7_1, %at7, %bt1)
          : (vector<16xf32>, vector<32xbf16>, vector<32xbf16>) -> vector<16xf32>

      scf.yield %nt0_0, %nt0_1, %nt1_0, %nt1_1, %nt2_0, %nt2_1, %nt3_0, %nt3_1, %nt4_0, %nt4_1, %nt5_0, %nt5_1, %nt6_0, %nt6_1, %nt7_0, %nt7_1
          : vector<16xf32>, vector<16xf32>, vector<16xf32>, vector<16xf32>, vector<16xf32>, vector<16xf32>, vector<16xf32>, vector<16xf32>, vector<16xf32>, vector<16xf32>, vector<16xf32>, vector<16xf32>, vector<16xf32>, vector<16xf32>, vector<16xf32>, vector<16xf32>
    }

    vector.store %rt#0, %C[%it0, %jv0] : memref<128x4096xf32>, vector<16xf32>
    vector.store %rt#1, %C[%it0, %jvt1] : memref<128x4096xf32>, vector<16xf32>
    vector.store %rt#2, %C[%it1, %jv0] : memref<128x4096xf32>, vector<16xf32>
    vector.store %rt#3, %C[%it1, %jvt1] : memref<128x4096xf32>, vector<16xf32>
    vector.store %rt#4, %C[%it2, %jv0] : memref<128x4096xf32>, vector<16xf32>
    vector.store %rt#5, %C[%it2, %jvt1] : memref<128x4096xf32>, vector<16xf32>
    vector.store %rt#6, %C[%it3, %jv0] : memref<128x4096xf32>, vector<16xf32>
    vector.store %rt#7, %C[%it3, %jvt1] : memref<128x4096xf32>, vector<16xf32>
    vector.store %rt#8, %C[%it4, %jv0] : memref<128x4096xf32>, vector<16xf32>
    vector.store %rt#9, %C[%it4, %jvt1] : memref<128x4096xf32>, vector<16xf32>
    vector.store %rt#10, %C[%it5, %jv0] : memref<128x4096xf32>, vector<16xf32>
    vector.store %rt#11, %C[%it5, %jvt1] : memref<128x4096xf32>, vector<16xf32>
    vector.store %rt#12, %C[%it6, %jv0] : memref<128x4096xf32>, vector<16xf32>
    vector.store %rt#13, %C[%it6, %jvt1] : memref<128x4096xf32>, vector<16xf32>
    vector.store %rt#14, %C[%it7, %jv0] : memref<128x4096xf32>, vector<16xf32>
    vector.store %rt#15, %C[%it7, %jvt1] : memref<128x4096xf32>, vector<16xf32>
  }
  return
}

func.func @main() {
  %c0 = arith.constant 0 : index
  %c1 = arith.constant 1 : index
  %reps = arith.constant $REPS : index
  // 0x3F803F80 = two packed bf16 1.0 values
  %pair = arith.constant 1065369472 : i32
  %zf = arith.constant 0.0 : f32

  %Ap = memref.alloc() : memref<128x2048xi32>
  %Bp = memref.alloc() : memref<128x2048x32xi32>
  %C = memref.alloc() : memref<128x4096xf32>
  linalg.fill ins(%pair : i32) outs(%Ap : memref<128x2048xi32>)
  linalg.fill ins(%pair : i32) outs(%Bp : memref<128x2048x32xi32>)
  linalg.fill ins(%zf : f32) outs(%C : memref<128x4096xf32>)

  // Warmup: page faults and first touch land here, not in the timed
  // region.  It also adds one K to C, which the checksum accounts for.
  func.call @gemm(%Ap, %Bp, %C) : (memref<128x2048xi32>, memref<128x2048x32xi32>, memref<128x4096xf32>) -> ()

  %t0 = func.call @rtclock() : () -> f64
  scf.for %r = %c0 to %reps step %c1 {
    func.call @gemm(%Ap, %Bp, %C) : (memref<128x2048xi32>, memref<128x2048x32xi32>, memref<128x4096xf32>) -> ()
  }
  %t1 = func.call @rtclock() : () -> f64

  %dt = arith.subf %t1, %t0 : f64
  func.call @printF64(%dt) : (f64) -> ()
  func.call @printNewline() : () -> ()

  // Checksum: C accumulates, so after warmup + $REPS passes every
  // element is K * (1 + $REPS) = 4096 * (1 + $REPS).
  %v = memref.load %C[%c0, %c0] : memref<128x4096xf32>
  %vf = arith.extf %v : f32 to f64
  func.call @printF64(%vf) : (f64) -> ()
  func.call @printNewline() : () -> ()

  // ...and C[0][0] alone would not notice a bad remainder tile or a
  // mis-indexed column, so count every element that is not K*(1+reps).
  %rp1 = arith.addi %reps, %c1 : index
  %rpi = arith.index_cast %rp1 : index to i32
  %rpf = arith.sitofp %rpi : i32 to f32
  %kf = arith.constant 4096.0 : f32
  %exp = arith.mulf %rpf, %kf : f32
  %cM = arith.constant 128 : index
  %cN = arith.constant 4096 : index
  %bad = scf.for %ii = %c0 to %cM step %c1 iter_args(%o = %c0) -> (index) {
    %brow = scf.for %jj = %c0 to %cN step %c1 iter_args(%p = %o) -> (index) {
      %cv = memref.load %C[%ii, %jj] : memref<128x4096xf32>
      %ne = arith.cmpf one, %cv, %exp : f32
      %inc = arith.select %ne, %c1, %c0 : index
      %nx = arith.addi %p, %inc : index
      scf.yield %nx : index
    }
    scf.yield %brow : index
  }
  %badi = arith.index_cast %bad : index to i64
  %badf = arith.sitofp %badi : i64 to f64
  func.call @printF64(%badf) : (f64) -> ()
  func.call @printNewline() : () -> ()

  memref.dealloc %Ap : memref<128x2048xi32>
  memref.dealloc %Bp : memref<128x2048x32xi32>
  memref.dealloc %C : memref<128x4096xf32>
  return
}
